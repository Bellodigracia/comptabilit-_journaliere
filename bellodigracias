<body>
<div class="wrap">
  <h1>Solde du compte</h1>
  <p class="sub">Portefeuilles, espèces et créances, en un seul calcul.</p>
  <div class="status" id="syncStatus"><span class="dot"></span><span id="syncLabel">Connexion…</span></div>

  <div class="card">
    <h2>Soldes par portefeuille</h2>
    <div class="row head"><div></div><div style="text-align:right">$</div><div style="text-align:right">Fc</div></div>
    <div id="walletRows"></div>
    <div class="divider"></div>
    <div class="row">
      <div class="lbl" style="font-weight:600">Total</div>
      <div><input type="number" class="readonly" id="totalUSD" readonly></div>
      <div><input type="number" class="readonly" id="totalFC" readonly></div>
    </div>
  </div>

  <div class="card">
    <h2>Créances</h2>
    <div class="row">
      <div class="lbl">Créances</div>
      <div><input type="number" id="creancesUSD" value="0" step="0.01"></div>
      <div><input type="number" id="creancesFC" value="0" step="1"></div>
    </div>
  </div>

  <div class="card">
    <h2>Taux de change</h2>
    <div class="rate-row">
      <label for="rate">Francs congolais pour 1 $</label>
      <input type="number" id="rate" value="2252" step="0.01" min="0.01">
    </div>
  </div>

  <div class="card">
    <h2>Résultat</h2>
    <div class="result-grid">
      <div class="result"><div class="amt" id="sumUSD">0</div><div class="lbl">Total $ + créances $</div></div>
      <div class="result"><div class="amt" id="sumFCconv">0</div><div class="lbl">Total Fc + créances Fc, converti en $</div></div>
    </div>
    <div class="grand">
      <div class="amt" id="grandTotal">0 $</div>
      <div class="lbl">Total général équivalent</div>
    </div>
  </div>

  <div class="card">
    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
      <button id="saveBtn" class="save-btn">Enregistrer dans la base</button>
      <span id="saveFeedback" class="save-feedback"></span>
    </div>
    <div class="last-saved" id="lastSaved">Jamais enregistré</div>
  </div>

  <div class="card">
    <h2>Table enregistrée dans la base</h2>
    <p class="sub" style="margin-bottom:8px;">Chaque ligne ci-dessous est un enregistrement distinct de la base, avec son libellé et ses montants.</p>
    <div id="dbTableWrap"><div class="empty-table">Aucune donnée enregistrée pour l'instant.</div></div>
  </div>
</div>

<script>
const wallets = [
  {slug:'airtel-money', libelle:'Airtel money'},
  {slug:'orange-money', libelle:'Orange money'},
  {slug:'m-pesa', libelle:'M-pesa'},
  {slug:'vodacom', libelle:'Vodacom'},
  {slug:'africell', libelle:'Africell'},
  {slug:'especes', libelle:'Espèces'}
];
const CREANCES_SLUG = 'creances';

const walletRowsEl = document.getElementById('walletRows');
wallets.forEach((w, i)=>{
  const row = document.createElement('div');
  row.className = 'row';
  row.innerHTML = `
    <div class="lbl">${w.libelle}</div>
    <div><input type="number" class="usd-in" data-i="${i}" value="0" step="0.01"></div>
    <div><input type="number" class="fc-in" data-i="${i}" value="0" step="1"></div>
  `;
  walletRowsEl.appendChild(row);
});

const usdInputs = [...document.querySelectorAll('.usd-in')];
const fcInputs = [...document.querySelectorAll('.fc-in')];
const creancesUSD = document.getElementById('creancesUSD');
const creancesFC = document.getElementById('creancesFC');
const rateInput = document.getElementById('rate');
const allInputs = [...usdInputs, ...fcInputs, creancesUSD, creancesFC, rateInput];
const statusEl = document.getElementById('syncStatus');
const syncLabel = document.getElementById('syncLabel');
const saveBtn = document.getElementById('saveBtn');
const saveFeedback = document.getElementById('saveFeedback');
const lastSavedEl = document.getElementById('lastSaved');
const dbTableWrap = document.getElementById('dbTableWrap');

function num(el){ const v = parseFloat(el.value); return isNaN(v) ? 0 : v; }
function fmt(n, dec){
  return new Intl.NumberFormat('fr-FR',{minimumFractionDigits:dec, maximumFractionDigits:dec}).format(n);
}

function recalc(){
  const totalUSD = usdInputs.reduce((s,el)=>s+num(el),0);
  const totalFC = fcInputs.reduce((s,el)=>s+num(el),0);
  document.getElementById('totalUSD').value = totalUSD.toFixed(2);
  document.getElementById('totalFC').value = totalFC.toFixed(0);

  const cUSD = num(creancesUSD);
  const cFC = num(creancesFC);
  const rate = num(rateInput) || 1;

  const sumUSD = totalUSD + cUSD;
  const sumFC = totalFC + cFC;
  const sumFCconv = sumFC / rate;
  const grand = sumUSD + sumFCconv;

  document.getElementById('sumUSD').textContent = fmt(sumUSD,2) + ' $';
  document.getElementById('sumFCconv').textContent = fmt(sumFCconv,2) + ' $';
  document.getElementById('grandTotal').textContent = fmt(grand,2) + ' $';
}

function buildRows(){
  const rows = wallets.map((w,i)=>({
    slug: w.slug, libelle: w.libelle, usd: num(usdInputs[i]), fc: num(fcInputs[i]), type: 'portefeuille'
  }));
  rows.push({slug: CREANCES_SLUG, libelle: 'Créances', usd: num(creancesUSD), fc: num(creancesFC), type: 'créance'});
  return rows;
}

function renderTable(rows){
  if(!rows || !rows.length){
    dbTableWrap.innerHTML = '<div class="empty-table">Aucune donnée enregistrée pour l\u2019instant.</div>';
    return;
  }
  const order = {};
  wallets.forEach((w,i)=>{ order[w.slug] = i; });
  order[CREANCES_SLUG] = wallets.length;
  const sorted = [...rows].sort((a,b)=> (order[a.slug] ?? 99) - (order[b.slug] ?? 99));
  let html = '<table class="db-table"><thead><tr><th>Libellé</th><th class="num">$</th><th class="num">Fc</th><th>Type</th></tr></thead><tbody>';
  sorted.forEach(r=>{
    html += `<tr><td>${r.libelle}</td><td class="num">${fmt(r.usd,2)}</td><td class="num">${fmt(r.fc,0)}</td><td class="type">${r.type}</td></tr>`;
  });
  html += '</tbody></table>';
  dbTableWrap.innerHTML = html;
}

function applyRows(rows){
  const bySlug = {};
  rows.forEach(r=>{ bySlug[r.slug] = r; });
  wallets.forEach((w,i)=>{
    const r = bySlug[w.slug];
    if(!r) return;
    if(document.activeElement!==usdInputs[i]) usdInputs[i].value = r.usd;
    if(document.activeElement!==fcInputs[i]) fcInputs[i].value = r.fc;
  });
  const cr = bySlug[CREANCES_SLUG];
  if(cr){
    if(document.activeElement!==creancesUSD) creancesUSD.value = cr.usd;
    if(document.activeElement!==creancesFC) creancesFC.value = cr.fc;
  }
  recalc();
  renderTable(rows);
}

function stampSaved(date){
  const d = date ? new Date(date) : new Date();
  lastSavedEl.textContent = 'Dernière sauvegarde : ' + d.toLocaleString('fr-FR');
}

function setStatus(mode){
  statusEl.className = 'status' + (mode==='synced' ? ' synced' : mode==='readonly' ? ' readonly' : '');
  syncLabel.textContent = mode==='synced' ? 'Synchronisé — partagé avec le lien'
    : mode==='readonly' ? 'Lecture seule (pas d\u2019accès en écriture)'
    : mode==='offline' ? 'Hors ligne — les données ne sont pas enregistrées'
    : 'Connexion…';
}

allInputs.forEach(el=>{
  el.addEventListener('input', recalc);
});

let lignesCol = null;
let tauxDoc = null;
let canWrite = true;

saveBtn.addEventListener('click', async ()=>{
  if(!lignesCol || !tauxDoc){
    saveFeedback.textContent = 'Non connecté à la base.';
    saveFeedback.className = 'save-feedback error';
    return;
  }
  if(!canWrite){
    saveFeedback.textContent = 'Lecture seule : pas de droit d\u2019écriture.';
    saveFeedback.className = 'save-feedback error';
    return;
  }
  saveBtn.disabled = true;
  saveFeedback.textContent = 'Enregistrement…';
  saveFeedback.className = 'save-feedback';
  const rows = buildRows();
  try{
    for(const r of rows){
      await lignesCol.doc(r.slug).set(r);
    }
    await tauxDoc.set({valeur: num(rateInput) || 1});
    saveFeedback.textContent = 'Enregistré ✓';
    stampSaved();
    renderTable(rows);
  }catch(e){
    if(e && (e.code === 'not_granted' || e.code === 'not_writer')){
      canWrite = false;
      setStatus('readonly');
    }
    saveFeedback.textContent = 'Échec de l\u2019enregistrement.';
    saveFeedback.className = 'save-feedback error';
    console.error('Save error', e);
  }
  saveBtn.disabled = false;
});

async function init(){
  recalc();
  let db = null;
  try{ db = await claude.use('db'); }catch(e){ db = null; }
  if(!db){
    setStatus('offline');
    return;
  }
  lignesCol = db.collection('lignes');
  tauxDoc = db.doc('parametres/taux');
  try{
    const snap = await lignesCol.get();
    const rows = (snap && snap.docs) ? snap.docs.map(d=>d.data) : [];
    if(rows.length) applyRows(rows);
    const tauxSnap = await tauxDoc.get();
    if(tauxSnap && tauxSnap.data && tauxSnap.data.valeur){
      rateInput.value = tauxSnap.data.valeur;
      recalc();
    }
    if(rows.length) stampSaved();
    setStatus('synced');
  }catch(e){
    console.error('Load error', e);
    setStatus('offline');
  }
  try{
    lignesCol.onSnapshot((snap)=>{
      const rows = (snap && snap.docs) ? snap.docs.map(d=>d.data) : [];
      if(rows.length){
        applyRows(rows);
        stampSaved();
      }
    });
  }catch(e){ console.error('Subscribe error', e); }
}

init();
</script>
</body>
</html>
